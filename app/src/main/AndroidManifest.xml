<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The promise AnonPDF keeps is that documents cannot leave the device. That
      rests on having no network permission at all: the entries below are removed
      from the merged manifest, so if any dependency ever tries to introduce
      them the build strips them out again. Without INTERNET the kernel refuses
      outbound sockets, which is enforcement rather than a policy statement.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
      Storage access, so the app can browse and open PDFs directly instead of
      routing every single file through the system picker.

      This is the only permission declared, and deliberately so. Under scoped
      storage READ_EXTERNAL_STORAGE and READ_MEDIA_IMAGES only reach *media*;
      a PDF sitting in Downloads is not media, so neither of them would let the
      browser list anything. Declaring them would add Play friction for no
      capability.

      It is optional at runtime: decline it and AnonPDF falls back to the Storage
      Access Framework, which needs no permission and still opens and saves files.
      Google treats all-files access as restricted and wants a declaration in Play
      Console explaining why a picker is not enough; see PLAYSTORE.md.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".AnonPdfApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnonPDF">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:theme="@style/Theme.AnonPDF"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open PDFs handed to us by other apps (files, mail, browser downloads). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!--
          Lets the user hand a finished file to another app they choose from the
          share sheet. Not exported, no permissions granted until the user picks a
          target, and scoped to the output folder in our own cache.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
